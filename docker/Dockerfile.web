# VahaanBandhu Next.js frontend (development image).
#
# Runs `next dev`, which is what the compose stack wants: the source tree is
# bind-mounted, so edits reload without a rebuild. A production image would run
# `next build && next start` against a copied tree with no mount.
#
# No Prisma step here. An earlier revision copied the prisma schema before
# install to satisfy a `postinstall: prisma generate` script; Prisma has since
# been removed from the frontend entirely, so the workaround is gone too.
FROM node:20-alpine

WORKDIR /app

# Dependency layer first so it caches across source changes.
COPY package.json package-lock.json* ./
RUN npm ci || npm install

COPY . .

ENV NEXT_TELEMETRY_DISABLED=1

EXPOSE 3000

# 0.0.0.0 so the port is reachable from outside the container; binding to
# localhost inside a container makes it unreachable from the host.
CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0"]
