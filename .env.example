# Copy to .env and fill in. Never commit .env.

# --- Routing ---
# Comma-separated TomTom keys; the provider rotates on quota/expiry.
TOMTOM_API_KEYS=
TOMTOM_BASE_URL=https://api.tomtom.com

# --- Quantum (offline research/benchmark stage only) ---
IBM_QUANTUM_CHANNEL=ibm_cloud
IBM_QUANTUM_TOKEN=

# --- Application database ---
# Existing app uses Supabase Postgres via Prisma.
DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
SUPABASE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: only set if the MongoDB track is enabled.
MONGODB_URI=

# --- Auth (existing app uses Kinde, not Clerk) ---
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_ISSUER_URL=
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000/api/auth/creation
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000

# --- Service URLs (no hardcoded localhost in app code) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
