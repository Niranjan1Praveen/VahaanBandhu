# VahaanBandhu — environment template.
# Copy to .env and fill in what you have. NEVER commit .env.
#
# Nothing here is required to start the application locally. Every integration
# degrades in a documented way, so an empty file still gives you a running app
# with local data.

# ---------------------------------------------------------------- application
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------ databases
# Defaults match the docker-compose services.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=vahaanbandhu

# Redis is a cache, never a source of truth. If it is unreachable the
# application keeps working and every cache operation degrades to a miss.
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
ROUTE_CACHE_TTL_S=900

# ----------------------------------------------------------------------- auth
# Clerk is the real authentication path. Without these the sign-in page says so
# plainly and does not silently fall back to demo mode.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_ISSUER=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Development-only demo sign-in. Active ONLY when this is true AND
# ENVIRONMENT is not production -- both conditions are enforced server-side, so
# a single misconfigured variable cannot expose it in production.
DEV_AUTH_ENABLED=true

# ------------------------------------------------------------- roads, traffic
# Comma-separated TomTom keys. The provider rotates automatically on 401/403/429,
# so an expired key does not take routing down. Without any key the map falls
# back to straight-line estimates, clearly labelled as estimates.
TOMTOM_API_KEYS=
TOMTOM_BASE_URL=https://api.tomtom.com

# --------------------------------------------------------------------- routing
# VB-QER execution profile: live | quality | research
VBQER_PROFILE=live

# Operational cache for provider responses. Point this at a writable directory
# when the research artifacts are mounted read-only.
# VB_ROUTE_CACHE_DIR=

# ------------------------------------------------------------------- frontend
# Must be reachable from the BROWSER. In production this is the public backend
# URL, never an internal container hostname.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --------------------------------------------------------------------- quantum
# Offline research only. The application never calls quantum hardware while
# serving a request, and starts normally with these unset.
IBM_QUANTUM_CHANNEL=ibm_cloud
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_OFFLINE_ONLY=true
